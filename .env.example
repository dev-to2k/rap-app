# Postgres (Neon free) — required for Vercel + local after postgres switch
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Session cookie HMAC (min 32 chars)
SESSION_SECRET="change-me-session-secret-min-32-chars!!"

# Signed download URL HMAC
DOWNLOAD_HMAC_SECRET="change-me-download-hmac-secret!!!!"

# Payment webhook verification stub
WEBHOOK_SECRET="change-me-webhook-secret!!!!!!!!!!!!"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# On Vercel Preview set to https://rap-app-five.vercel.app

# MoMo Business (sandbox) — leave empty to keep mock pay
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn
# MOMO_REDIRECT_URL=
# MOMO_IPN_URL=

# R2 / blob (later)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Payment mocks — required for /api/pay/mock and simulateWebhook. Never set in production.
# ALLOW_PAYMENT_MOCKS=true
