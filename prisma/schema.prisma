// Rap App — Prisma schema (PostgreSQL / Neon free for Vercel + local)
// Set DATABASE_URL=postgresql://...?sslmode=require

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      String     // buyer | producer | admin
  createdAt DateTime   @default(now())
  beats     Beat[]
  orders    Order[]
  licenses  License[]
}

model Beat {
  id             String     @id @default(cuid())
  title          String
  coverUrl       String?
  audioUrl       String
  wavUrl         String?
  stemsUrl       String?
  bpm            Int
  musicalKey     String
  sampleFlag     String     // clean | uncleared
  priceLease     Int        // VND
  priceWav       Int
  priceExclusive Int
  status         String     @default("available") // available | reserved | sold_exclusive | delisted
  reservedAt     DateTime?  // soft-reserve timestamp; cleared on sold/release; TTL ~15m
  producerId     String
  producer       User       @relation(fields: [producerId], references: [id])
  createdAt      DateTime   @default(now())
  orders         Order[]
  auditLogs      AuditLog[]
}

model Order {
  id                    String    @id @default(cuid())
  buyerId               String
  buyer                 User      @relation(fields: [buyerId], references: [id])
  beatId                String
  beat                  Beat      @relation(fields: [beatId], references: [id])
  sku                   String    // lease | wav | exclusive
  amountVnd             Int
  /// Buyer gross (usually = amountVnd)
  gmvVnd                Int       @default(0)
  /// MoMo / PSP fee (MVP default 0)
  momoFeeVnd            Int       @default(0)
  /// Platform take = round(gmv * takeRateBps / 10000)
  takeVnd               Int       @default(0)
  /// Producer net = max(0, gmv - momoFee - take)
  payableVnd            Int       @default(0)
  /// CoS fund: portion of takeVnd held in platform fund (not ops-withdrawable)
  fundWithheldFromTake  Int       @default(0)
  /// CoS fund: takeVnd - fundWithheldFromTake (platform ops-withdrawable)
  platformTakeWithdrawable Int    @default(0)
  takeRateBps           Int
  status                String    @default("pending") // pending | pending_ck | awaiting_payment | pending_confirm | paid | unlocked | failed
  paymentMethod         String?   // momo | vnpay | ck
  paymentRef            String?
  webhookIdempotencyKey String?   @unique
  createdAt             DateTime  @default(now())
  paidAt                DateTime?
  /// Set when license unlock succeeds
  unlockedAt            DateTime?
  /// Finance: unlockedAt + 5d (48h dispute + T+3); null when failed/conflict/refund (not payable)
  payableAt             DateTime?
  /// Set when producer net credited once; blocks double-credit
  creditedAt            DateTime?
  license               License?
}

model License {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id])
  beatId        String
  sku           String
  pdfPath       String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  beatId    String?
  beat      Beat?    @relation(fields: [beatId], references: [id])
  action    String
  meta      String?
  createdAt DateTime @default(now())
}

/// Durable rate-limit buckets (Vercel serverless — in-memory Map does not share)
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model PlatformConfig {
  id                 String    @id @default("default")
  takeRateBps        Int       @default(1500)
  promoTakeRateBps   Int?
  promoEndsAt        DateTime?
}

model WaitlistSignup {
  id          String   @id @default(cuid())
  email       String
  handle      String?
  role        String
  catalogUrl  String?
  src         String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  createdAt   DateTime @default(now())

  @@index([email])
}
